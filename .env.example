# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPOSE_EVIDENCE=5
GROQ_MAX_CHUNK_CHARS=1200

# Cohere Embeddings
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBEDDING_MODEL=embed-v5.0-fast

# Qdrant Vector Database (leave QDRANT_URL and QDRANT_API_KEY empty for local embedded Qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=microsoft_2025_annual_report
QDRANT_VECTOR_SIZE=2048

# CORS (comma-separated allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173

# Future phases / optional integrations
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=financial-analyst-agent
# ALPHA_VANTAGE_API_KEY=
# POSTGRES_URL=